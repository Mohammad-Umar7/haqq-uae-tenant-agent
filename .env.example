# Copy this file to .env and fill in your key. Never commit .env.
# Without a real key the app runs in demo mode (no LLM).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional settings (defaults shown)
# Low-cost default. Use claude-sonnet-5-5 or claude-opus-5-5 for stronger reasoning.
CLAUDE_MODEL=claude-haiku-5-5
# How much the model thinks: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# Safety limit on tool-call rounds per question
AGENT_MAX_TOOL_ROUNDS=10

# Spend guards (useful on a public deploy)
# Stop an analysis once it has cost this much (USD), all agents together
HAQQ_MAX_COST_PER_RUN_USD=0.05
# LLM questions allowed per browser session (screenshot readings count too)
HAQQ_MAX_REQUESTS_PER_SESSION=20
# Largest upload accepted (contracts and screenshots), and most PDF pages
HAQQ_MAX_UPLOAD_MB=5
HAQQ_MAX_PDF_PAGES=10

# Free repeats: identical requests are answered from this local folder
HAQQ_CACHE_ENABLED=true
# HAQQ_CACHE_DIR=.haqq_cache

# The drafting team: the Critic (the landlord's lawyer) reviews every letter
# with Claude and the Drafter revises it once. false = template letter plus
# the free automatic check only (cheaper; Arabic is still written if asked).
HAQQ_CRITIC_ENABLED=true
